{
  "name": "Data Analyst Intake",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "analyze", "responseMode": "responseNode", "options": {} },
      "id": "da1-0001-4000-8000-000000000001",
      "name": "Webhook1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, 0],
      "webhookId": "da1-webhook-analyze-0001"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.file;\nconst filename = binary?.fileName || \"\";\nconst validExtensions = [\".csv\", \".xlsx\", \".xls\"];\nconst isValid = validExtensions.some(ext => filename.toLowerCase().endsWith(ext));\n\nreturn [{\n  json: {\n    ...item.json,\n    is_valid_file: isValid,\n    filename: filename,\n    error: isValid ? null : `Invalid file type. Got \"${filename}\", expected .csv, .xlsx, or .xls`\n  },\n  binary: item.binary\n}];"
      },
      "id": "da1-0002-4000-8000-000000000002",
      "name": "Validate File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "da1-cond-0001",
              "leftValue": "={{ $json.is_valid_file }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da1-0003-4000-8000-000000000003",
      "name": "Valid File?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ { \"error\": $json.error } }}",
        "options": {}
      },
      "id": "da1-0004-4000-8000-000000000004",
      "name": "File Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [160, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8002/data/analyze",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "file" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "da1-0005-4000-8000-000000000005",
      "name": "Call Data Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [160, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "da1-cond-0002",
              "leftValue": "={{ $json.report_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da1-0006-4000-8000-000000000006",
      "name": "Analysis Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [400, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 500,
        "responseBody": "={{ { \"error\": \"Analysis failed. Please check the file format and try again.\" } }}",
        "options": {}
      },
      "id": "da1-0007-4000-8000-000000000007",
      "name": "Analysis Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/1551924817626927174/gdjgGhvIn3NZaXqSQ5TqsHTGoYmWGWL5OQG6AJBUuLu2MyGrBBFO90ks78YPSKM2sulj",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"content\": \"📊 **Data Analysis Report**\\n\" + $json.telegram_summary + \"\\n\\nFull report: http://localhost:8002\" + $json.report_url }",
        "options": {}
      },
      "id": "da1-0008-4000-8000-000000000008",
      "name": "Send Discord Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [640, -160]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": {} },
      "id": "da1-0009-4000-8000-000000000009",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, -160]
    }
  ],
  "connections": {
    "Webhook1": { "main": [[{ "node": "Validate File", "type": "main", "index": 0 }]] },
    "Validate File": { "main": [[{ "node": "Valid File?", "type": "main", "index": 0 }]] },
    "Valid File?": {
      "main": [
        [{ "node": "Call Data Agent", "type": "main", "index": 0 }],
        [{ "node": "File Error Response", "type": "main", "index": 0 }]
      ]
    },
    "Call Data Agent": { "main": [[{ "node": "Analysis Successful?", "type": "main", "index": 0 }]] },
    "Analysis Successful?": {
      "main": [
        [{ "node": "Send Discord Alert", "type": "main", "index": 0 }],
        [{ "node": "Analysis Error Response", "type": "main", "index": 0 }]
      ]
    },
    "Send Discord Alert": { "main": [[{ "node": "Success Response", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
